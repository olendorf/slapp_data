<div id="visitor_locations_container" class='centered' data-ids="<%= params['resource_ids'] %>"
     style="width:800px; height:800px; background: url('/assets/512px-Loader.gif'); background-repeat:no-repeat; background-position: center"></div>

<script type="text/javascript">

        $(function () {  
                var resource_ids = $('#visitor_locations_container').data('ids')
                $.getJSON('/async/visits', 
                                {
                                    ids: resource_ids,
                                    chart: 'visitor_locations'
                                },
                                function(data) {

                    // draw chart
                     $('#visitor_locations_container').highcharts({ 
                          chart: {
                                type: 'scatter',
                                zoomType: 'xy',
                                style: {
                                  fontFamily: 'Arial, Helvetica, Clean, sans-serif'
                                },
                                events: {
                                  load: function() {
                	                        document.getElementById('visitor_locations_container').style.background = 'none';
                                        }
                                }
                            },
                            title: {
                                text: 'Visitor Locations (Last 1000 visits)'
                            },
                            xAxis: {
                                title: null,
                                min: 0,
                                max: 255,
                                startOnTick: true,
                                endOnTick: true,
                                tickInterval: 16
                            },
                            yAxis: {
                                max: 255,
                                title: null,
                                endOnTick: true,
                                tickInterval: 16,
                                gridLineWidth: null,
                                visible: true
                            },
                            legend: {
                                enabled: false
                            },  
                            credits: {
                              enabled: false
                            },
                            plotOptions: {
                                scatter: {
                                    marker: {
                                        radius: 2.5,
                                        states: {
                                            hover: {
                                                enabled: true,
                                                lineColor: 'rgb(100,100,100)'
                                            }
                                        }
                                    },
                                    states: {
                                        hover: {
                                            marker: {
                                                enabled: false
                                            }
                                        }
                                    },
                                    tooltip: {
                                        useHTML: true,
                                        headerFormat: '<b>{point.point.name}</b><br>',
                                        pointFormat: '{point.point.slurl}',
                                        style: {
                                          pointerEvents: 'auto'
                                        }
                                    }
                                }
                            },
                            series: [{
                                data: data
                            }]
                    
   
                    }); 
                });
            });


</script>