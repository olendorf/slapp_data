
<div id="donation_counts_container" data-ids=<%= params['resource_ids'] %>
     style="width:600px; height:400px;; background: url('/assets/512px-Loader.gif'); background-repeat:no-repeat; background-position: center"></div>

<script type="text/javascript">

        $(function () {
                var resource_ids = $('#donation_counts_container').data('ids')
                $.getJSON('/async/donations', 
                                {
                                    ids: resource_ids,
                                    chart: 'donation_count_histogram'
                                },
                                function(data) {

                    // draw chart
                     $('#donation_counts_container').highcharts({ 
                        chart: {
                            style: {
                              fontFamily: 'Arial, Helvetica, Clean, sans-serif'
                            },
                            events: {
                              load: function() {
            	                        document.getElementById('donation_counts_container').style.background = 'none';
                                    }
                            }
                        },
                    
                        title: {
                            text: 'Frequency of Donation Amounts'
                            // text: gon.ids
                        },
                    
                        xAxis: [{
                            alignTicks: false,
                            visible: false
                        }, {
                            title: { text: 'Donation Amount' },
                            alignTicks: false
                        }],
                    
                        yAxis: [{
                            visible: false
                        }, {
                            title: { text: 'Count' }
                        }],
                    
                        plotOptions: {
                            histogram: {
                                accessibility: {
                                    valueDescriptionFormat: function (point) {
                                        var ix = point.index + 1,
                                            x1 = point.x.toFixed(3),
                                            x2 = point.x2.toFixed(3),
                                            val = point.y;
                                        return ix + '. ' + x1 + ' to ' + x2 + ', ' + val + '.';
                                    }
                                }
                            }
                        },
                        
                        legend: {
                        	enabled: false
                        }, 
                        credits: {
                          enabled: false
                        },
                    
                        series: [{
                            name: 'Donations',
                            type: 'histogram',
                            binsNumber: 'rice',
                            xAxis: 1,
                            yAxis: 1,
                            baseSeries: 's1',
                            zIndex: -1
                        }, {
                            name: 'Data',
                            visible: false,
                            type: 'scatter',
                            data: data,
                            id: 's1',
                            marker: {
                                radius: 1.5
                            }
                        }]
                    }); 
                });
            });


</script>