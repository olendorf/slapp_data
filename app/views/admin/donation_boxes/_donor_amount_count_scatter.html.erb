<div id="donor_amount_count_scatter_container" data-ids="<%= params['resource_ids'] %>"
     style="width:600px; height:400px;; background: url('/assets/512px-Loader.gif'); background-repeat:no-repeat; background-position: center"></div>

<script type="text/javascript">

        $(function () {  
                var resource_ids = $('#donor_amount_count_scatter_container').data('ids')
                $.getJSON('/async/donations', 
                                {
                                    ids: resource_ids,
                                    chart: 'donor_amount_count_scatter'
                                },
                                function(data) {

                    // draw chart
                     $('#donor_amount_count_scatter_container').highcharts({ 
                          chart: {
                                type: 'scatter',
                                zoomType: 'xy',
                                style: {
                                  fontFamily: 'Arial, Helvetica, Clean, sans-serif'
                                },
                                events: {
                                  load: function() {
                	                        document.getElementById('donor_amount_count_scatter_container').style.background = 'none';
                                        }
                                }
                            },
                            title: {
                                text: 'Amount Donated by Number of Donations'
                            },
                            xAxis: {
                                title: {
                                    enabled: true,
                                    text: 'Donations'
                                },
                                min: 0,
                                startOnTick: true,
                                endOnTick: true,
                                showLastLabel: true,
                                tickInterval: 1
                            },
                            yAxis: {
                                title: {
                                    text: 'Amount Donated ( L$ )'
                                },
                                min: 0
                            },
                            legend: {
                                enabled: false
                            },  
                            credits: {
                              enabled: false
                            },
                            plotOptions: {
                                scatter: {
                                    marker: {
                                        radius: 5,
                                        states: {
                                            hover: {
                                                enabled: true,
                                                lineColor: 'rgb(100,100,100)'
                                            }
                                        }
                                    },
                                    states: {
                                        hover: {
                                            marker: {
                                                enabled: false
                                            }
                                        }
                                    },
                                    tooltip: {
                                        headerFormat: '<b>{point.target_name}</b><br>',
                                        pointFormat: '{point.x} donation, {point.y} L$'
                                    }
                                }
                            },
                            series: [{
                                name: 'Donations',
                                data: data
                            }]
                    
   
                    }); 
                });
            });


</script>